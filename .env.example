# Banco de dados (PostgreSQL) — local, ou serviço gerenciado (Neon, Supabase, Railway)
# DATABASE_URL: conexão da aplicação. Em produção, use a URL com pool do provedor.
# DIRECT_URL:   conexão direta, usada pelas migrações. Localmente, repita a mesma URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meusalao?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/meusalao?schema=public"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# Login social com Google (opcional; o botão só aparece se estiver configurado)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Envio de e-mail (opcional; sem a chave, a mensagem vai para o log do servidor)
# Crie a chave em https://resend.com. Sem um dominio proprio verificado, o
# Resend so entrega para o e-mail dono da conta.
RESEND_API_KEY=""
# Remetente. So mude depois de verificar um dominio no Resend.
EMAIL_REMETENTE="MeuSalao <onboarding@resend.dev>"
