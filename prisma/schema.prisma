generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexão da aplicação — em produção, a URL com pool do provedor.
  url       = env("DATABASE_URL")
  // Conexão direta, usada pelas migrações (o pool não dá conta delas).
  // Em ambiente local, aponta para a mesma URL.
  directUrl = env("DIRECT_URL")
}

enum Papel {
  CLIENTE
  DONO_SALAO
  ADMIN
}

// PENDENTE não está no PRD (seção 5.5), mas o RF25 exige que o salão "confirme
// ou recuse os agendamentos pendentes" — sem esse estado o requisito não existe.
// Recusa do salão e cancelamento do cliente caem os dois em CANCELADO.
enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

enum DiaSemana {
  DOM
  SEG
  TER
  QUA
  QUI
  SEX
  SAB
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  telefone  String?
  // Nulo quando a conta foi criada por login social (Google)
  senhaHash String?
  papel     Papel    @default(CLIENTE)
  imagem    String?
  criadoEm  DateTime @default(now())

  contas       Conta[]
  saloes       Salao[]       @relation("DonoSaloes")
  agendamentos Agendamento[]
  avaliacoes   Avaliacao[]

  @@map("usuarios")
}

model Salao {
  id        String   @id @default(cuid())
  donoId    String
  nome      String
  descricao String?
  endereco  String
  telefone  String?
  latitude  Float?
  longitude Float?
  tipo      String?
  // RGN05: só aparece na busca e no mapa depois de publicado.
  publicado Boolean  @default(false)
  criadoEm  DateTime @default(now())

  dono         Usuario                @relation("DonoSaloes", fields: [donoId], references: [id], onDelete: Cascade)
  servicos     Servico[]
  horarios     HorarioFuncionamento[]
  agendamentos Agendamento[]
  avaliacoes   Avaliacao[]

  @@index([donoId])
  // RNF03: a busca filtra por publicado antes de qualquer outra coisa.
  @@index([publicado])
  @@map("saloes")
}

model Servico {
  id         String   @id @default(cuid())
  salaoId    String
  nome       String
  // Opcional: sem preço, a vitrine exibe "Consultar preço" (RGN06).
  preco      Decimal? @db.Decimal(10, 2)
  duracaoMin Int
  criadoEm   DateTime @default(now())

  salao        Salao         @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@index([salaoId])
  @@map("servicos")
}

model HorarioFuncionamento {
  id             String    @id @default(cuid())
  salaoId        String
  diaSemana      DiaSemana
  // "HH:MM" no fuso do salão. Guardar como texto evita arrastar uma data
  // fictícia só para representar hora do dia.
  horaAbertura   String
  horaFechamento String
  ativo          Boolean   @default(true)

  salao Salao @relation(fields: [salaoId], references: [id], onDelete: Cascade)

  // Um registro por dia da semana em cada salão.
  @@unique([salaoId, diaSemana])
  @@map("horarios_funcionamento")
}

model Agendamento {
  id        String            @id @default(cuid())
  clienteId String
  salaoId   String
  servicoId String
  dataHora  DateTime
  // Copiada do serviço no momento do agendamento, por dois motivos: o salão
  // pode mudar a duração do serviço depois, e isso não deve reescrever o
  // passado; e a restrição de sobreposição no banco precisa do fim do
  // atendimento na própria linha.
  duracaoMin Int
  status    StatusAgendamento @default(PENDENTE)
  criadoEm  DateTime          @default(now())

  cliente   Usuario    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  salao     Salao      @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  servico   Servico    @relation(fields: [servicoId], references: [id])
  avaliacao Avaliacao?

  // RGN02 é garantida por uma restrição EXCLUDE criada à mão na migração: no
  // mesmo salão, dois atendimentos não podem ter intervalos que se cruzem
  // (dataHora → dataHora + duracaoMin), ignorando os cancelados. Nem o
  // @@unique do PRD nem um índice único em (salaoId, dataHora) dariam conta:
  // os dois só comparam o INÍCIO, então um corte de 60 min às 10:00 não
  // impediria outro de 30 min às 10:30, com o salão ocupado até as 11:00.
  @@index([clienteId, dataHora])
  @@index([salaoId, dataHora])
  @@map("agendamentos")
}

model Avaliacao {
  id            String   @id @default(cuid())
  clienteId     String
  salaoId       String
  agendamentoId String   @unique
  nota          Int
  comentario    String?
  criadoEm      DateTime @default(now())

  cliente     Usuario     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  salao       Salao       @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([salaoId])
  @@map("avaliacoes")
}

// Vínculo com um provedor externo (ex.: Google), usado no login social
model Conta {
  id                String @id @default(cuid())
  usuarioId         String
  provedor          String
  idNoProvedor      String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provedor, idNoProvedor])
  @@map("contas")
}
