generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexão da aplicação — em produção, a URL com pool do provedor.
  url       = env("DATABASE_URL")
  // Conexão direta, usada pelas migrações (o pool não dá conta delas).
  // Em ambiente local, aponta para a mesma URL.
  directUrl = env("DIRECT_URL")
}

enum Papel {
  CLIENTE
  DONO_SALAO
  ADMIN
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  telefone  String?
  // Nulo quando a conta foi criada por login social (Google)
  senhaHash String?
  papel     Papel    @default(CLIENTE)
  imagem    String?
  criadoEm  DateTime @default(now())

  contas Conta[]

  @@map("usuarios")
}

// Vínculo com um provedor externo (ex.: Google), usado no login social
model Conta {
  id                String @id @default(cuid())
  usuarioId         String
  provedor          String
  idNoProvedor      String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provedor, idNoProvedor])
  @@map("contas")
}
