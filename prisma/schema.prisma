generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexão da aplicação — em produção, a URL com pool do provedor.
  url       = env("DATABASE_URL")
  // Conexão direta, usada pelas migrações (o pool não dá conta delas).
  // Em ambiente local, aponta para a mesma URL.
  directUrl = env("DIRECT_URL")
}

enum Papel {
  CLIENTE
  DONO_SALAO
  ADMIN
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  telefone  String?
  // Nulo quando a conta foi criada por login social (Google)
  senhaHash String?
  papel     Papel    @default(CLIENTE)
  imagem    String?
  criadoEm  DateTime @default(now())

  contas       Conta[]
  salao        Salao?
  agendamentos Agendamento[]
  avaliacoes   Avaliacao[]

  @@map("usuarios")
}

// Vínculo com um provedor externo (ex.: Google), usado no login social
model Conta {
  id                String @id @default(cuid())
  usuarioId         String
  provedor          String
  idNoProvedor      String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provedor, idNoProvedor])
  @@map("contas")
}

model Salao {
  id        String   @id @default(cuid())
  donoId    String   @unique
  nome      String
  descricao String?
  endereco  String
  telefone  String?
  latitude  Float?
  longitude Float?
  tipo      String?
  publicado Boolean  @default(false)
  criadoEm  DateTime @default(now())

  dono         Usuario                @relation(fields: [donoId], references: [id], onDelete: Cascade)
  servicos     Servico[]
  horarios     HorarioFuncionamento[]
  agendamentos Agendamento[]
  avaliacoes   Avaliacao[]

  @@map("saloes")
}

model Servico {
  id         String   @id @default(cuid())
  salaoId    String
  nome       String
  preco      Decimal? @db.Decimal(10, 2)
  duracaoMin Int

  salao        Salao         @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@map("servicos")
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

model HorarioFuncionamento {
  id             String    @id @default(cuid())
  salaoId        String
  diaSemana      DiaSemana
  horaAbertura   String
  horaFechamento String
  ativo          Boolean   @default(true)

  salao Salao @relation(fields: [salaoId], references: [id], onDelete: Cascade)

  @@unique([salaoId, diaSemana])
  @@map("horarios_funcionamento")
}

enum StatusAgendamento {
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

model Agendamento {
  id        String            @id @default(cuid())
  clienteId String
  salaoId   String
  servicoId String
  dataHora  DateTime
  status    StatusAgendamento @default(CONFIRMADO)
  criadoEm  DateTime          @default(now())

  cliente   Usuario    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  salao     Salao      @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  servico   Servico    @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  avaliacao Avaliacao?

  @@unique([salaoId, dataHora])
  @@map("agendamentos")
}

model Avaliacao {
  id            String   @id @default(cuid())
  clienteId     String
  salaoId       String
  agendamentoId String   @unique
  nota          Int
  comentario    String?
  criadoEm      DateTime @default(now())

  cliente     Usuario     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  salao       Salao       @relation(fields: [salaoId], references: [id], onDelete: Cascade)
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@map("avaliacoes")
}
